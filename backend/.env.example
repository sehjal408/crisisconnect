PORT=4000

# Database driver:
#   (unset / anything)  -> embedded PostgreSQL (PGlite), zero setup  [local dev]
#   pg                  -> connect to a real PostgreSQL server        [production]
DB_DRIVER=pg

# PostgreSQL connection (used only when DB_DRIVER=pg).
# Option A — a single connection string, which hosted providers (Neon, Render,
# Supabase) give you. node-postgres reads DATABASE_URL automatically:
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
#
# Option B — the individual parts (used for a local Postgres):
PGHOST=localhost
PGPORT=5432
PGDATABASE=crisisconnect
PGUSER=postgres
PGPASSWORD=postgres

# Set PGSSL=require for hosted databases that require SSL (Neon, Supabase, and
# Render's EXTERNAL url). Leave blank for local Postgres or Render's internal url.
PGSSL=

# JWT
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h

# ---- Week 9: AI auto-triage ------------------------------------------------
# AI_TRIAGE: on | off  (off = always use the offline keyword heuristic)
# ANTHROPIC_API_KEY: leave blank to run on the heuristic; add a key from
#   console.anthropic.com to use the real Claude model. Never commit a real key.
# AI_MODEL: which Claude model to use for triage.
AI_TRIAGE=on
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5

# ---- Week 9/10: live incident feeds ----------------------------------------
# Pulls incidents from official public sources (USGS, BC Wildfire, Environment
# Canada). No API keys required. Needs internet; if offline, feeds are skipped.
INGEST_ENABLED=on
INGEST_ON_BOOT=on        # run one ingest shortly after startup
INGEST_INTERVAL_MIN=30   # periodic refresh; 0 = off

# ---- CORS (production) -----------------------------------------------------
# Leave blank to allow all origins (simplest for a demo). To lock down, set your
# frontend's URL(s), comma-separated, e.g. https://crisisconnect.vercel.app
CORS_ORIGIN=
