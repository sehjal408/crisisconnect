PORT=4000

# Database driver:
#   (unset / anything)  -> embedded PostgreSQL (PGlite), zero setup
#   pg                  -> connect to a real PostgreSQL server (uses the PG* vars below)
DB_DRIVER=pg

# PostgreSQL connection (used only when DB_DRIVER=pg)
PGHOST=localhost
PGPORT=5432
PGDATABASE=crisisconnect
PGUSER=postgres
PGPASSWORD=postgres

# JWT
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h
