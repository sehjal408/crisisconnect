# Copy this file to .env (the real .env is git-ignored)
# Controls how the frontend talks to the API:
#   real  -> use the real Express API, fall back to in-browser demo data if it's offline
#   demo  -> always use the in-browser demo data (no backend needed)
VITE_API=real

# Backend URL. Leave BLANK for local dev (the Vite dev-server proxies /api to
# localhost:4000). In production set it to your deployed backend's URL, e.g.
#   VITE_API_URL=https://crisisconnect-api.onrender.com
# (no trailing slash, no /api/v1 suffix — the app appends that).
VITE_API_URL=
